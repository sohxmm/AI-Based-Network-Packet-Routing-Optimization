# Copy to .env (or just run `make up`, which does it for you).

# -- PostgreSQL --
POSTGRES_USER=routinguser
POSTGRES_PASSWORD=change-me-before-deploying
POSTGRES_DB=routing_db

# -- Backend --
# Inside Docker this is overridden by docker-compose.yml (host `db`, port 5432).
# The value below is for running the backend directly on your machine, where
# compose publishes PostgreSQL on host port 5433.
DATABASE_URL=postgresql+asyncpg://routinguser:change-me-before-deploying@localhost:5433/routing_db
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
TICK_SECONDS=1.0

# -- Live network probing (opt-in) --
# Set to 1 to allow the dashboard to measure real hosts with ICMP echo.
# Read-only and unprivileged, but only enable it for networks you are
# authorised to measure.
LIVE_PROBE_ENABLED=0

# -- pgAdmin (only started with: docker compose --profile dev up) --
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me-before-deploying
